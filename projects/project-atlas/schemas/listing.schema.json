{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/listing.schema.json",
  "title": "Normalized Listing",
  "description": "Canonical record for one asset listing observed on any source platform. Raw platform payloads are preserved verbatim under `raw`; every other top-level object is the normalized, cross-platform view derived from it. Never overwrite `raw` — normalization bugs must be replayable against the original payload.",
  "type": "object",
  "required": ["record_id", "source", "raw", "asset", "location", "pricing", "scoring"],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identity for this listing observation. Re-scrapes of the same live listing update the same record_id; do not mint a new one per crawl pass."
    },
    "dedup_key": {
      "type": "string",
      "description": "Fuzzy-match key (e.g. hash of VIN/serial + platform-agnostic title/price/location signature) used to link the same physical asset across multiple platforms. Populated by the dedup/image-fingerprint pipeline, not the crawler."
    },
    "source": {
      "type": "object",
      "required": ["platform", "url", "scraped_at", "listing_type", "status"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "description": "Source marketplace/dealer/auction house, e.g. IronPlanet, GovPlanet, MachineryTrader." },
        "platform_listing_id": { "type": "string", "description": "The platform's own ID for this listing, if exposed." },
        "url": { "type": "string", "format": "uri" },
        "scraped_at": { "type": "string", "format": "date-time" },
        "first_seen_at": { "type": "string", "format": "date-time", "description": "First time this listing was observed, across all re-crawls." },
        "listing_type": { "type": "string", "enum": ["auction", "fixed_price", "make_offer", "classified", "liquidation", "government_surplus"] },
        "status": { "type": "string", "enum": ["active", "sold", "expired", "withdrawn", "relisted"] },
        "language": { "type": "string", "description": "Original listing language (ISO 639-1), before translation." }
      }
    },
    "raw": {
      "type": "object",
      "description": "Untouched, platform-specific payload as scraped. Schema intentionally unconstrained — shape varies per source.",
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": ["category", "manufacturer"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "description": "Controlled vocabulary term, see taxonomy.schema.json (e.g. compact_tractor, skid_steer, mri_machine)." },
        "manufacturer": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"], "minimum": 1900 },
        "serial_number": { "type": ["string", "null"] },
        "vin": { "type": ["string", "null"] },
        "identity_ref": { "type": ["string", "null"], "format": "uuid", "description": "Foreign key into asset_identity records once VIN/serial decoding has run." },
        "hours": { "type": ["number", "null"], "minimum": 0 },
        "miles": { "type": ["number", "null"], "minimum": 0 },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "fuel_type": { "type": ["string", "null"], "enum": ["diesel", "gasoline", "electric", "hybrid", "propane", "natural_gas", null] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seller_condition": { "type": ["string", "null"], "enum": ["new", "excellent", "good", "fair", "poor", "salvage", null] },
        "inspection_available": { "type": "boolean", "default": false },
        "damage_notes": { "type": "array", "items": { "type": "string" } },
        "photo_count": { "type": "integer", "minimum": 0, "default": 0 },
        "photo_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "ai_condition_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Output of the computer-vision condition model, not an input." }
      }
    },
    "location": {
      "type": "object",
      "required": ["country"],
      "additionalProperties": false,
      "properties": {
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "country": { "type": "string", "description": "ISO 3166-1 alpha-2." },
        "postal_code": { "type": ["string", "null"] },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    },
    "pricing": {
      "type": "object",
      "required": ["currency"],
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "description": "ISO 4217 code as listed on source; conversion to USD happens downstream, never in place." },
        "current_bid": { "type": ["number", "null"], "minimum": 0 },
        "buy_now_price": { "type": ["number", "null"], "minimum": 0 },
        "asking_price": { "type": ["number", "null"], "minimum": 0 },
        "reserve_met": { "type": ["boolean", "null"] },
        "buyer_premium_pct": { "type": ["number", "null"], "minimum": 0 },
        "estimated_fees": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "auction": {
      "type": "object",
      "description": "Populated only when source.listing_type is auction-like.",
      "additionalProperties": false,
      "properties": {
        "start_at": { "type": ["string", "null"], "format": "date-time" },
        "end_at": { "type": ["string", "null"], "format": "date-time" },
        "bid_count": { "type": ["integer", "null"], "minimum": 0 },
        "watchers": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "comparables": {
      "type": "object",
      "description": "Cached output of the valuation engine at last scoring pass, not raw input.",
      "additionalProperties": false,
      "properties": {
        "regional_fmv": { "type": ["number", "null"], "description": "Fair market value." },
        "regional_olv": { "type": ["number", "null"], "description": "Orderly liquidation value." },
        "regional_flv": { "type": ["number", "null"], "description": "Forced liquidation value." },
        "sold_comp_count_60d": { "type": ["integer", "null"], "minimum": 0 },
        "price_variance": { "type": ["number", "null"] }
      }
    },
    "friction": {
      "type": "object",
      "description": "Denormalized snapshot of latest logistics_friction estimate for this listing; see logistics_friction.schema.json for the source-of-truth record.",
      "additionalProperties": false,
      "properties": {
        "estimated_transport_cost": { "type": ["number", "null"], "minimum": 0 },
        "estimated_repair_cost": { "type": ["number", "null"], "minimum": 0 },
        "estimated_cleaning_cost": { "type": ["number", "null"], "minimum": 0 },
        "estimated_tax": { "type": ["number", "null"], "minimum": 0 },
        "total_friction_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "scoring": {
      "type": "object",
      "description": "Output of the Opportunity Engine / Buy Score model. Always model-derived; never hand-entered.",
      "additionalProperties": false,
      "properties": {
        "expected_resale_value": { "type": ["number", "null"] },
        "expected_days_to_sell": { "type": ["number", "null"], "minimum": 0 },
        "gross_spread": { "type": ["number", "null"] },
        "net_expected_profit": { "type": ["number", "null"] },
        "roi_pct": { "type": ["number", "null"] },
        "confidence_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "buy_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "recommendation": { "type": ["string", "null"], "enum": ["buy_now", "watch", "pass", null] },
        "model_version": { "type": ["string", "null"], "description": "Buy Score model version that produced this scoring block." },
        "scored_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
