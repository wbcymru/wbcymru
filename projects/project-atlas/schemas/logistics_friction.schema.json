{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/logistics_friction.schema.json",
  "title": "Logistics & Friction Estimate",
  "description": "Everything it costs to get an asset from where it sits to a sellable, sold state: transport, repair, cleaning, tax, and misc fees. This is the source-of-truth record; listing.friction carries a denormalized snapshot of the latest total for quick display. One listing can accumulate multiple friction records over time (e.g. re-quoted transport as carrier pricing changes) — consumers should take the most recent by computed_at.",
  "type": "object",
  "required": ["friction_id", "listing_record_id", "computed_at"],
  "additionalProperties": false,
  "properties": {
    "friction_id": { "type": "string", "format": "uuid" },
    "listing_record_id": { "type": "string", "format": "uuid" },
    "computed_at": { "type": "string", "format": "date-time" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "object",
          "properties": {
            "city": { "type": ["string", "null"] },
            "state": { "type": ["string", "null"] },
            "country": { "type": "string" },
            "postal_code": { "type": ["string", "null"] }
          }
        },
        "destination": {
          "type": "object",
          "description": "Nearest resale hub or buyer-specified destination used for this quote.",
          "properties": {
            "city": { "type": ["string", "null"] },
            "state": { "type": ["string", "null"] },
            "country": { "type": "string" },
            "postal_code": { "type": ["string", "null"] }
          }
        },
        "distance_miles": { "type": ["number", "null"], "minimum": 0 },
        "mode": { "type": ["string", "null"], "enum": ["ltl", "ftl", "hotshot", "rail", "ocean_freight", "air_freight", "driveaway", null] },
        "equipment_type": { "type": ["string", "null"], "enum": ["flatbed", "step_deck", "rgn", "lowboy", "conestoga", "hotshot_trailer", "other", null], "description": "Heavy-haul trailer configuration; rgn/lowboy for oversize construction equipment." },
        "rate_per_mile": { "type": ["number", "null"], "minimum": 0, "description": "Flatbed rate per mile, e.g. from the DAT Freight Rate index." },
        "rate_type": { "type": ["string", "null"], "enum": ["spot", "contract", "historical", null], "description": "DAT and similar indexes publish distinct spot/contract/historical rate series; record which one rate_per_mile came from." },
        "fuel_surcharge_pct": { "type": ["number", "null"], "minimum": 0, "description": "Typically sourced from regional_demand.macro_signals.national_diesel_reference at quote time; frozen here once quoted, same as other snapshot fields on this record." },
        "permit_cost": { "type": ["number", "null"], "minimum": 0, "description": "Oversize/overweight load permitting." },
        "escort_vehicle_count": { "type": ["integer", "null"], "minimum": 0 },
        "escort_vehicle_cost": { "type": ["number", "null"], "minimum": 0, "description": "Cost line item for pilot/escort vehicles. The legal requirement this satisfies is tracked separately as listing.location.compliance.regulatory_flags[flag=escort_vehicle_required] — that's the gate, this is the cost." },
        "assembly_disassembly_cost": { "type": ["number", "null"], "minimum": 0, "description": "Field assembly/disassembly for oversize equipment (e.g. cranes) that can't move intact." },
        "carrier_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["carrier", "quote_amount", "currency"],
            "properties": {
              "carrier": { "type": "string" },
              "quote_amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string" },
              "transit_days": { "type": ["number", "null"], "minimum": 0 },
              "backhaul": { "type": "boolean", "default": false },
              "quoted_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "selected_quote_carrier": { "type": ["string", "null"] },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0, "description": "Best available estimate: selected quote if booked, else lowest live quote, else model-predicted cost." }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_source": { "type": ["string", "null"], "enum": ["vision_ai", "service_history", "manual_inspection", "seller_disclosure", null] },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue", "estimated_cost"],
            "properties": {
              "issue": { "type": "string", "description": "e.g. hydraulic_leak, tire_wear, frame_damage." },
              "component": { "type": ["string", "null"] },
              "estimated_cost": { "type": "number", "minimum": 0 },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "required_for_sale": { "type": "boolean", "default": false, "description": "False for cosmetic/optional repairs that improve resale value but aren't blocking." }
            }
          }
        },
        "total_estimated_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "cleaning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdiction": { "type": ["string", "null"] },
        "tax_type": { "type": ["string", "null"], "enum": ["sales_tax", "use_tax", "import_duty", "vat", null] },
        "rate_pct": { "type": ["number", "null"], "minimum": 0 },
        "estimated_amount": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "other_fees": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspection_cost": { "type": ["number", "null"], "minimum": 0 },
        "storage_cost_per_day": { "type": ["number", "null"], "minimum": 0 },
        "documentation_fee": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "total_friction_cost": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Sum of transport.estimated_cost + repair.total_estimated_cost + cleaning.estimated_cost + tax.estimated_amount + other_fees.*. Recomputed whenever any component changes."
    }
  }
}
